# Written by Ansible. Edit the Ansible variables, not this file.
PORT={{ web_port }}
NODE_ENV={{ app_env }}
MOCKDESK_DB={{ data_dir }}/mockdesk.db
MOCKDESK_UPLOADS={{ data_dir }}/uploads
MOCKDESK_BACKUPS={{ data_dir }}/backups
MOCKDESK_ADMIN_EMAILS={{ admin_emails }}
{% if trust_proxy | default(false) | bool %}
MOCKDESK_TRUST_PROXY=1
{% endif %}
{% if smtp_host %}
SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}
SMTP_USER={{ smtp_user }}
SMTP_PASS={{ smtp_pass }}
MAIL_FROM={{ mail_from }}
{% endif %}
{% if public_url | default('') %}
MOCKDESK_PUBLIC_URL={{ public_url }}
{% endif %}

# Optional. You do NOT need this file for keys: email, SMS, WhatsApp and AI keys can be typed in Admin > Integrations and keys (stored encrypted, applied instantly).
# Values set in the admin panel override the same names below. This file is a fallback.
# Optional. Copy to ".env" for local runs. On the AWS one-click kit the server settings are written by Ansible instead.
# Anything about the SITE (name, contact, limits, time zone, home page text) is set in Admin > Settings, not here.

# ---- Sign-in codes by email (any SMTP provider: Amazon SES, Brevo, Zoho, Gmail app password ...) ----
# Without this, codes are printed in the server log (fine for testing, not for real students).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MockDesk <no-reply@yourdomain.com>"

# ---- Sign-in codes by SMS: choose ONE provider ----
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1xxxxxxxxxx
# SMS_PROVIDER=msg91
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# ---- WhatsApp (optional) ----
# WHATSAPP_PROVIDER=meta        # needs WHATSAPP_TOKEN, WHATSAPP_PHONE_ID, WHATSAPP_TEMPLATE
# WHATSAPP_PROVIDER=twilio      # needs TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, WHATSAPP_FROM

# ---- AI answer drafts and doubt assistant (optional) ----
# ANTHROPIC_API_KEY=

# ---- Server ----
# PORT=3000
# NODE_ENV=production               # use behind HTTPS
# MOCKDESK_DB=data/mockdesk.db      # database file
# MOCKDESK_BACKUPS=data/backups     # where automatic backups go
# MOCKDESK_TRUST_PROXY=1            # set when a proxy or load balancer sits in front
# MOCKDESK_ADMIN_EMAILS=you@example.com
